# cp .env.example .env してローカル用パスワードを設定する (ローカル bolt 接続のみで使用)
NEO4J_PASSWORD=change-me
# EDINET DB (edinetdb.jp) の API キー。edb_ プレフィックス。REST 用 (MCP は ~/.claude.json に登録)
EDINETDB_API_KEY=change-me
# 公式 EDINET API v2 の Subscription-Key (https://api.edinet-fsa.go.jp で発行。scripts/edinet.py 用、未取得なら空)
EDINET_API_KEY=
